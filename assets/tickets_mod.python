#! /usr/bin/env python


import os
import sys
import datetime
import re
import json
import sqlite3
import zipfile
import urllib
from collections import namedtuple
import sha


ticket = namedtuple("ticket", [ "id", "type", "time", "changetime", "component", 
                                "severity", "priority", "owner", "reporter", "cc", 
                                "version", "milestone", "status", "resolution", 
                                "summary", "description", "keywords"])

ticket_change = namedtuple("ticket_change", [ "ticket", "time", "author", "field", 
                                              "oldvalue", "newvalue", "ticket_id", "comment_id" ])

comment = namedtuple("ticket_change", [ "ticket", "time", "author", "field", 
                                        "comment_num", "comment", "ticket_id", "comment_id" ])

attachment = namedtuple("attachment", [ "type", "id", "filename", "size", "time",
                                        "description", "author", "ipnr", ])

milestone = namedtuple("milestone", [ "name", "due", "completed", "description", ])

version = namedtuple("version", [ "name", "time", "description", ])

component = namedtuple("component", [ "name", "owner", "description", ])

def add_keywords(text, keys):
    kw = str(keys)
    #text = text + "Keyword: " + kw
    text+="\n\n"
    for word in kw.split(" "):
        #text = text + "**Keyword:** " + word + "\n\n"
        text += "**Keyword:** " + word + "  \n"
    return text

def convert_time(tractime):
    dt = datetime.datetime.fromtimestamp(tractime/1000000.0)
    return dt.isoformat()+"+00:00"

def trac_to_markdown(text):
    # convert links
    url_regex = re.compile(r"\[\[(.*?)\|(.*?)\]\]")
    text = url_regex.sub(r"[\2](\1)", text)
    
    # convert code blocks and some trac-specific text
    indent = 0
    out = []
    for line in text.split('\n'):
        if line.startswith("#!CommitTicketReference"):
            pass
        elif line.startswith("{{{") and indent == 0:
            indent += 4
            out.append("")
        elif line.startswith("}}}") and indent > 0:
            indent -= 4
        else:
            if indent == 0:
                # change inline {{{...}}} to `...`
                line = re.sub(r'{{{', r'`', line)
                line = re.sub(r'}}}', r'`', line)
            out.append("%s%s" % (" " * indent, line))


    return "\n".join(out)

TYPES = {
    'defect': 'bug',
    'enhancement': 'enhancement',
    'discussion': 'proposal',
    'note': 'proposal',
    'proposal': 'proposal',
    'task': 'task',
}
STATUSES = {
    'new': 'new',
    'accepted': 'open',
    'assigned': 'open',
    'pending': 'open',
    'reopened': 'open',
    'closed': 'resolved',
    'worksforme': 'wontfix',
    'invalid': 'invalid',
    'duplicate': 'duplicate',
    'wontfix': 'wontfix',
    'fixed': 'resolved',
    'review': 'open',
    'reviewed_ok': 'open',
    'confirmed': 'open',
}
USERMAP = {
    '': None,
}
PRIORITIES = {
    None: 'minor',
    '--': 'minor',
    'critical': 'critical',
    'high': 'major',
    'normal': 'minor',
    'low': 'trivial',
    'wish': 'trivial',
}
FIELDS = {
    "cc": "watchers",
    "owner": "assignee",
    "component": "component",
    "milestone" : "milestone",
    "priority" : "priority",
    "status": "status",
    "summary": "title", 
    "type": "kind",
    "version": "version",
    "comment": "comment",
#    "resolution"  
#    "keywords" : ,
}

# we need a bit more than just a dict() to handle watchers since they area
# python list rather than just a single string
class WATCHERS:
    def get(self, watchers):
       return " ".join([str(USERMAP[x.strip()]) for x in watchers.split(",")] if watchers else [])
map_watchers = WATCHERS()

field_conv = {
    "priority":  PRIORITIES,
    "status":  STATUSES,
    "type": TYPES,
    "assignee":  USERMAP,
    "owner":  USERMAP,
    "reporter": USERMAP,
    "comment": USERMAP,
    "cc": map_watchers
}

KEEPEXTS = [ ".diff", ".patch", ".err", ".out", ".par", ".log", ".dsvn", ".patch2", ".txt", ".config", ".gz", ".DIFF", ".cfg", ".tz", ".m", ".py", ".h", ".pl", ".cc", ".hh", ".rpar", ".th", ".sh", ".asc", ".bz2", ".png", ".2", ".3", ".4", ".5", ".JPG", ".c", ".cpp", ".debug", ".defn", ".diff2", ".diff3", ".diffs", ".e1440381", ".f90", ".h5", ".html", ".ini", ".jpg", ".list", ".mw", ".o1440381", ".parfile", ".pdf", ".php", ".tex", ".tgz", ".vim", ".yl", ".zip", ".plt"]


class TracObject(object):
    obj = None
    issuedbname = None
    def __init__(self, vals, cursor=None):
        self.name = self.obj.__name__
        self.vals = self.obj(*vals)
        self.c = cursor

    def to_json(self):
        return { "name" : self.vals.name }

    def insert_in_issuedb(self, issuedb):
        issuedb[self.issuedbname].append(self.to_json())


class Milestone(TracObject):
    obj = milestone
    issuedbname = "milestones"

class Version(TracObject):
    obj = version
    issuedbname = "versions"

class Component(TracObject):
    obj = component
    issuedbname = "components"

class Attachment(TracObject):
    obj = attachment
    issuedbname = "attachments"
    def to_json(self):
        # compute hash of part before dot
        m = re.match(r'^(.*?)([.][^.]*)?$', self.vals.filename)
        fn = m.group(1)
        ext = m.group(2) or ""
        if not ext in KEEPEXTS:
            ext = ""
        hashed = sha.new(self.vals.filename).hexdigest()+ext
        ticket_hash = sha.new(self.vals.id).hexdigest()
        return { 
            "filename" : self.vals.filename,
            "issue" : self.vals.id,
            # this constructed path seems incorrect in that it misses the
            # "tickets" part that the zipfile uses
            "path": os.path.join("attachments", ticket_hash[0:3], ticket_hash, hashed),
            "user": USERMAP[self.vals.author],
            }

class TicketChange(TracObject):
    obj = ticket_change
    issuedbname = "logs"
    def to_json(self):
        return { 
            "issue": self.vals.ticket,
            "changed_from": self.vals.oldvalue,
            "changed_to": self.vals.newvalue,
            "comment": self.vals.comment_id,
            "field": self.vals.field,
            "created_on": convert_time(self.vals.time),
            "user": USERMAP[self.vals.author],
            }

class Comment(TracObject):
    obj = comment
    issuedbname = "comments"
    def to_json(self):
        return {
            "content": trac_to_markdown(self.vals.comment),
            "created_on": convert_time(self.vals.time),
            "id": self.vals.comment_id,
            "issue": self.vals.ticket_id,
            "updated_on": convert_time(self.vals.time),
            "user": USERMAP[self.vals.author],
            }


def idgenerator(start=0):
    while True:
        yield start
        start += 1

comment_id = idgenerator()


class Ticket(TracObject):
    obj = ticket
    issuedbname = "issues"
    def __init__(self, vals, cursor):
        TracObject.__init__(self, vals, cursor)
        self.id = self.vals.id

        self.c.execute("select * from attachment where type='ticket' and id=?", (self.id,))
        self.attachments = [Attachment(tc) for tc in self.c]
        self.comments = []
        self.ticket_changes = []


        self.c.execute("select time from ticket_change where ticket=? group by time", (self.id,))
        comment_times = self.c.fetchall()
        for ct, in comment_times:
            self.c.execute("select * from ticket_change where ticket=? and time=?", (self.id, ct))
            cid = next(comment_id)
            comment_issued = False
            for tc in self.c:
                tc += (self.id, cid)
                tcc = ticket_change(*tc)
                if tcc.field == "comment":
                    self.comments.append(Comment(tc))
                    comment_issued = True
                # we need a bit more than just a dict() to handle watchers since bitbucket does
                # not really track changes to them. So we just record them and otherwise create
                # a list for bitbucket in its ticket
                if tcc.field == 'cc':
                    self.vals._replace(cc = tcc.newvalue)
                if tcc.field in FIELDS:
                    if tcc.field in field_conv:
                        tcc = tcc._replace(oldvalue = field_conv[tcc.field].get(tcc.oldvalue),
                                           newvalue = field_conv[tcc.field].get(tcc.newvalue))
                    # value cannot be null but empty string has the same semantic
                    if tcc.newvalue is None: 
                        tcc = tcc._replace(newvalue = "")
                    tcc = tcc._replace(field = FIELDS[tcc.field])
                    self.ticket_changes.append(TicketChange(tcc))
            if not comment_issued:
                tcc = tcc._replace(field="comment", 
                                   newvalue=None)
                self.comments.append(Comment(tcc))

        
    def to_json(self):
        content_updated_time = max([self.vals.time,] #self.vals.changetime]
                                   +[t.vals.time for t in self.ticket_changes]
                                   +[c.vals.time for c in self.comments])

        return {
            "reporter": USERMAP[self.vals.reporter],
            "assignee": USERMAP[self.vals.owner],
            "title": self.vals.summary,
            "content": trac_to_markdown(add_keywords(self.vals.description, self.vals.keywords)),
            "created_on": convert_time(self.vals.time),
            "updated_on": convert_time(content_updated_time),
            "content_updated_on": convert_time(content_updated_time),
            "edited_on": None,
            "id": self.vals.id,
            "kind": TYPES.get(self.vals.type,"task"),
            "component": self.vals.component,
            "milestone": self.vals.milestone,
            "priority": PRIORITIES[self.vals.severity],
            "status": STATUSES[self.vals.status],
            "version": self.vals.version,
            "watchers": [USERMAP[x.strip()] for x in self.vals.cc.split(",")] if self.vals.cc else None,
            }
    
    
    def insert_in_issuedb(self, issuedb):
        TracObject.insert_in_issuedb(self, issuedb)
        for a in self.attachments:
            a.insert_in_issuedb(issuedb)
        for tc in self.ticket_changes:
            tc.insert_in_issuedb(issuedb)
        for cmt in self.comments:
            cmt.insert_in_issuedb(issuedb)



def build_issue_db(options):

    dbcnx = sqlite3.connect(options.tracdb)


    issue_db = { 
        "issues":[],
        "comments":[],
        "attachments":[],
        "logs":[],
        "meta": {
            "default_assignee": None,
            "default_component": None,
            "default_kind": "bug", 
            "default_milestone": None,
            "default_version": None
            },
        "components":[],
        "milestones":[],
        "versions":[] }
    
    c = dbcnx.cursor()
    c2 = dbcnx.cursor()
    
    for obj in Milestone, Version, Component, Ticket :
        c.execute("select * from %s" % obj.obj.__name__)
        n = 0
        for val in c:
            #if n > 100:
            l = obj(val,c2)
            l.insert_in_issuedb(issue_db)
            n = n + 1
            if n > 2400:
                break
            
    return issue_db
    

def build_zip(options):
    zipf = zipfile.ZipFile(options.output_file, "w")
    idb = build_issue_db(options)
    zipf.writestr("db-1.0.json", json.dumps(idb, indent=8))
    for att in idb["attachments"]:
        # compute hash of part before dot
        m = re.match(r'^(.*?)([.][^.]*)?$', att["filename"])
        fn = m.group(1)
        ext = m.group(2) or ""
        if not ext in KEEPEXTS:
            ext = ""
        hashed = sha.new(att["filename"]).hexdigest()+ext
        ticket_hash = sha.new(str(att["issue"])).hexdigest()
        source = os.path.join(options.attachments_dir, "ticket", ticket_hash[0:3], ticket_hash, hashed)
        if not os.path.exists(source) and os.path.exists(source+(m.group(2) or "")):
            print "keep",m.group(2)
        source = urllib.quote(source)
        zipf.write(source, att["path"])
    zipf.close()


def main():
    import argparse

    parser = argparse.ArgumentParser()
    
    parser.add_argument("--tracdir", "-t")
    parser.add_argument("--tracdb", "--db", "-f")
    parser.add_argument("--attachments-dir", "-A")
    parser.add_argument("--output", "-o")

    options = parser.parse_args()
    
    if options.tracdir:
        if not options.tracdb:
            options.tracdb = os.path.join(options.tracdir, "db/trac.db")
        if not options.attachments_dir:
            options.attachments_dir = os.path.join(options.tracdir, "attachments")
    if not options.tracdb:
        parser.error("No trac.db file provided (--tracdir or --tracdb)")
    if not options.attachments_dir:
        parser.error("No attachments folder provided (--tracdir or --attachments-dir)")
    options.output_file = open(options.output, "w") if options.output else sys.stdout
    
    build_zip(options)

if __name__ == "__main__":
    main()
    
